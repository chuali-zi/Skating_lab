# Copy to .env and replace all passwords; .env is ignored by Git.
POSTGRES_PASSWORD=replace-local-admin-password
DB_URL=jdbc:postgresql://localhost:15432/skating_coach
DB_USERNAME=skating_app
DB_PASSWORD=replace-local-app-password
DB_MIGRATION_USERNAME=skating_migrator
DB_MIGRATION_PASSWORD=replace-local-migration-password
# Development sessions are disabled unless explicitly enabled by the server config.
SPRING_PROFILES_ACTIVE=dev
# Configure these only when a provider has been selected. No model runs on Android.
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
# Optional provider capabilities; enable JSON mode only when supported.
LLM_JSON_MODE=false
# 0 omits max_tokens and leaves the provider default.
LLM_MAX_OUTPUT_TOKENS=0
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
KNOWLEDGE_STORAGE_PATH=./storage/knowledge
