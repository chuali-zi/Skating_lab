# 复制为 .env 并按需修改；.env 已被 .gitignore 忽略
DATABASE_URL=postgresql://postgres:skating@localhost:5432/skating_coach
REDIS_URL=redis://localhost:6379/0

# 对象存储（MinIO，S3 兼容）
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=skating-assets

# 应用
API_PREFIX=/api/v1
DEBUG=true

# 首版必需的模型能力；部署别名由环境配置，不在仓库固定模型 ID。
# 当前骨架尚未实现适配器，设置这些变量不会启用真实调用。
# TEXT_MODEL_ALIAS=
# VISION_MODEL_ALIAS=
# MODEL_ENDPOINT=
